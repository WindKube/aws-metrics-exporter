{
  "index_patterns": ["aws-inventory-*"],
  "priority": 100,
  "template": {
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "resource": {
          "properties": {
            "type": { "type": "keyword" },
            "id": { "type": "keyword" },
            "name": { "type": "keyword" }
          }
        },
        "cloud": {
          "properties": {
            "provider": { "type": "keyword" },
            "region": { "type": "keyword" },
            "account": {
              "properties": {
                "id": { "type": "keyword" },
                "name": { "type": "keyword" }
              }
            }
          }
        },
        "aws": { "type": "flattened" }
      }
    }
  }
}
